<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.6.6-u9r1-candidate</Version>
    <AssemblyVersion>0.6.6.0</AssemblyVersion>
    <FileVersion>0.6.6.0</FileVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>PhotoSiftReborn</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PhotoSiftReborn.Core/PhotoSiftReborn.Core.csproj" />
    <ProjectReference Include="../PhotoSiftReborn.IO/PhotoSiftReborn.IO.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../assets/*.png" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/*.jpg" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
